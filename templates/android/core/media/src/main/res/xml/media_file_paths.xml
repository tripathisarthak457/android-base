<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the two directories camera captures and compressed uploads are written to. Never the whole
  cache directory: it also holds the HTTP cache of signed-in responses and the image cache, and a
  URI granted to another app would reach all of it.
-->
<paths>
    <cache-path name="captures" path="captures/" />
    <cache-path name="uploads" path="uploads/" />
</paths>
