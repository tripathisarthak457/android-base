<?xml version="1.0" encoding="utf-8"?>
<!--
  The one permission this module cannot work without, declared by the module that needs it. A
  project generated without networking therefore ships without INTERNET at all, rather than
  asking for a capability it never uses.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
