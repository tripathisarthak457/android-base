# Copy to `keystore.properties` and fill in. The real file is git-ignored and must never be
# committed; this template exists so the shape is discoverable without it.
#
# Store paths are relative to the root of the build. When a block is missing or its .jks cannot
# be found, that environment falls back to the debug key and the build says so — so a fresh
# clone still produces a running devDebug without anyone handing over secrets.
#
# dev and staging may legitimately share one key. prod and playstore must not share with
# anything: the Play upload key is the one credential whose loss cannot be undone.

dev.storeFile=keys/dev.jks
dev.storePassword=
dev.keyAlias=
dev.keyPassword=

staging.storeFile=keys/staging.jks
staging.storePassword=
staging.keyAlias=
staging.keyPassword=

prod.storeFile=keys/prod.jks
prod.storePassword=
prod.keyAlias=
prod.keyPassword=

playstore.storeFile=keys/playstore.jks
playstore.storePassword=
playstore.keyAlias=
playstore.keyPassword=
