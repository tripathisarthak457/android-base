<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the two cache directories captures and compressed images are written to.

  Deliberately not <external-path path="."> — that shares the whole of external storage with
  whichever app receives the URI, which is far more than a camera intent needs and is exactly the
  over-share these providers exist to prevent.
-->
<paths>
    <cache-path name="captures" path="captures/" />
    <cache-path name="uploads" path="." />
</paths>
