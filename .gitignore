# Gradle and Android
build/
.gradle/
.kotlin/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild
.cxx
*.hprof

# Signing material. The generator writes these; none of them belong in a repository, and the
# `keys/` directory in particular would be an upload key in public.
keystore.properties
keys/
*.jks
*.keystore

# The template's placeholder google-services.json is tracked deliberately — without it the
# generated project cannot run the Firebase plugin and the first build fails. It cannot be
# un-ignored from here: template/.gitignore ignores it and the nearer file wins, so it is
# force-added instead. Once tracked, git follows its changes regardless.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node and Next
node_modules/
.next/
out/
.vercel
.env
.env*.local
# Anything ending in .env too. The deploy script writes /etc/android-base.env on the server with
# the database password, the admin token and the IP salt in it, and sooner or later somebody
# copies one here to edit it.
*.env
*.tsbuildinfo
next-env.d.ts

# Go
web/api/androidgen-api
web/api/server
*.exe

# Agent tooling that installs itself into the working directory. Nothing to do with the project.
skills-lock.json
.claude/skills/

# Editors and OS
.vscode/
.DS_Store
Thumbs.db

# Anything generated while testing the generator
/out/
*.zip
.env*
