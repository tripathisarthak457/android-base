export const meta = {
  name: 'android-skills-v1-0-15',
  description: 'Fold Google Android skills v1.0.15 (5 new, 10 updated) into the overhaul: digest, feature-aware vendoring into generated projects with AGENTS/CLAUDE guidance, review loop, and notes to the agents that need the new rules',
  phases: [
    { title: 'Digest', detail: 'what the new and updated skills change for us' },
    { title: 'Vendor', detail: 'feature-aware vendoring in the generator (wt/WP02)' },
    { title: 'Review', detail: 'fresh-context review and fixes' },
  ],
}

// Fable first; after a failed Fable call (weekly limit) the rest of the run uses Opus (the user, Oct 15).
let fableOut = false
async function fableAgent(prompt, opts) {
  if (!fableOut) {
    const r = await agent(prompt, Object.assign({}, opts || {}, { model: 'fable' }))
    if (r !== null && r !== undefined) return r
    fableOut = true
    log('a Fable call failed; the rest of this run uses Opus')
  }
  return agent(prompt, Object.assign({}, opts || {}, { model: 'opus' }))
}

const R = '/home/crazyhusir/Documents/projects/tools/android-base'
const OV = '/home/crazyhusir/Documents/projects/tools/.overhaul'
const L = OV + '/bin/locked'
const SK = '/home/crazyhusir/.claude/plugins/marketplaces/android-skills'
const WT = OV + '/wt/WP02'
const NEWS = `Google's Android skills repository was updated from v1.0.13 (42dc227) to v1.0.15 (5bda39f) on Oct 12 and Oct 14. Changes: git -C ${SK} diff --stat 42dc227 5bda39f.
- New: jetpack-compose/jetpack-compose-performance, system/glance-canonical-layouts, wear/wear-widgets, cars/android-for-cars-parked-apps, device-ai/litert/litert-runtime.
- Updated: navigation/navigation-3, navigation/navigation-event, jetpack-compose/adaptive, profilers/android-profiler, testing/testing-setup, camera/camerax, play/engage-sdk-integration, play/play-billing-library-version-upgrade, wear/wear-compose-m3, and the xr glimmer skill.
The user wants the new skills incorporated and wants every project their generator produces to use them.`

const STATUS = { type: 'object', properties: { state: { type: 'string', enum: ['done', 'blocked'] }, summary: { type: 'string' } }, required: ['state', 'summary'] }
const REVIEW = { type: 'object', properties: { verdict: { type: 'string' }, blocking: { type: 'array', items: { type: 'object', properties: { file: { type: 'string' }, line: { type: 'integer' }, problem: { type: 'string' }, fix: { type: 'string' } }, required: ['file', 'problem', 'fix'] } }, nonblocking: { type: 'array', items: { type: 'string' } } }, required: ['verdict', 'blocking', 'nonblocking'] }

phase('Digest')
const digest = await fableAgent(`${NEWS}
TASK: read every new and updated SKILL.md and its references under ${SK} (use git -C ${SK} diff 42dc227 5bda39f for the updated ones), then update ${OV}/research/ANDROID-SKILLS-DIGEST.md in place, keeping its style:
1. For each new or changed rule that changes what we build: the rule, the owner package (WP02 build and vendoring; WP03 design system; WP04 navigation, shell and perf; WP04-perf, the smoothness deep work; WP05 glass; WP06 data and security; WP07 Compose Multiplatform; WP12 docs; WP13 verification), and whether code on the branches already follows it.
2. Give jetpack-compose-performance its own detailed section: we are chasing iOS-level smoothness, and the current root cause is the first frame after idle (CPU and GPU at idle clocks; see ${OV}/handoff/WP04-perf.md).
3. Rewrite "Vendored into generated projects" as a feature-aware map. Which skills every Android project gets, and which ones depend on a generator feature (for example: camerax with the camera/media feature; restore-credentials and verified-email with auth; play-billing with a billing feature if one exists; glance-canonical-layouts only with a widget feature; android-cli and jetpack-compose-performance always). Read the generator's feature list (python3 ${WT}/generator/create_project.py --list-features --json) to decide. Do the same for the Compose Multiplatform template.
Do not modify any repository. Save the file, then return a summary of the changes and the vendoring map.`, { label: 'digest:skills', phase: 'Digest', schema: STATUS })
if (!digest) throw new Error('digest failed')

phase('Vendor')
const IMPL = `${NEWS}
You implement the skills update in the generator. Worktree ${WT} on branch wp/WP02 (WP02-M2 owns vendoring; its run is waiting on other merges and the tree is clean. Read ${OV}/handoff/WP02-M2.md and ${OV}/handoff/WP02-M2-RESUME.md first.) WP02-M2 already vendors Google's skills into the template, with a tool that refreshes them: find it, and use it.
Do, per the updated vendoring map in ${OV}/research/ANDROID-SKILLS-DIGEST.md:
1. Refresh the vendored skills to v1.0.15, byte for byte, with LICENSE and NOTICE.
2. Add the new skills that apply.
3. Make vendoring feature-aware, so a generated project carries exactly the skills its features use: through the generator's feature specs (the files a feature owns) and the markers, the way other optional files work.
4. Update the template's AGENTS.md and CLAUDE.md (and the other agents' entry files) with when to use each skill, the generator repository's own AGENTS.md likewise, and the README's feature or skills table if one exists.
5. Add generator tests: a project with and without each feature gets the right skills folders and AGENTS.md lines.
6. Run the generator unit tests and the quick consistency matrix, through ${OV}/bin/memwait (Gradle only via ${L} gradle if needed).
Commit each step with a message that explains why, ending with "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"; stage explicit paths only. Never push. Never kill or stop processes you did not start.
Append a section "Android skills v1.0.15 (Oct 15)" to ${OV}/handoff/WP02-M2.md: what changed, the commits, the test results.`
let r = await fableAgent(IMPL, { label: 'vendor:skills', phase: 'Vendor', schema: STATUS })
if (!r) throw new Error('vendoring failed')

phase('Review')
for (let round = 1; round <= 3; round++) {
  const rv = await fableAgent(`You are a fresh-context reviewer. Review the Android skills v1.0.15 update on wp/WP02: git -C ${R} log --oneline -15 wp/WP02, then the diff of its skills commits. Check them against ${OV}/research/ANDROID-SKILLS-DIGEST.md (the vendoring map), the upstream files in ${SK} (vendored files must be byte-identical), the licence notices, the generator's feature mechanism, and the tests.
BLOCKING:
- wrong or missing skills for a feature;
- modified vendored files;
- a missing LICENSE or NOTICE;
- AGENTS.md or CLAUDE.md guidance that is wrong or vague;
- skills leaking into projects without the feature;
- broken or missing tests;
- slop.
Do not modify anything; cite file:line.`, { label: `review:skills#${round}`, phase: 'Review', schema: REVIEW })
  if (!rv) throw new Error('review failed')
  if (!rv.blocking.length) { log(`skills review #${round}: clean`); break }
  r = await fableAgent(`${IMPL}\n\nMODE: fix. A fresh-context reviewer found BLOCKING issues. Fix every one (commits with why-messages), re-run the tests, update the handoff, and return the same schema:\n${JSON.stringify(rv.blocking, null, 1)}\nNon-blocking: ${JSON.stringify(rv.nonblocking)}`, { label: `vendor:fix#${round}`, phase: 'Review', schema: STATUS })
  if (!r) throw new Error('fix failed')
}
return { digest: digest.summary, vendor: r.summary }
