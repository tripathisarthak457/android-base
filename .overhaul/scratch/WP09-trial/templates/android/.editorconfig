# Formatting, read by Android Studio and by most other editors without a plugin.
#
# Kotlin's official style with the line length and trailing commas this project already uses,
# so a file reformatted in the IDE produces no diff beyond what was actually changed.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.{xml,json,yml,yaml,toml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{gradlew,*.sh}]
end_of_line = lf

[*.bat]
end_of_line = crlf
