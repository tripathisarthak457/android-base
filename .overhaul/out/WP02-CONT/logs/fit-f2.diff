+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/**
+ * Keeps the list in memory and answers [refresh] with [result], counting the loads so a test can
+ * check that a screen does not load twice. Set [result] between events to script a failure or a
+ * recovery, and call [write] for rows that arrive without a refresh.
+ */
+class FakeAbcdefghijklmnopqrstuvwxyzabcdRepository(
+    var result: AppResult<List<AbcdefghijklmnopqrstuvwxyzabcdItem>>,
+) : AbcdefghijklmnopqrstuvwxyzabcdRepository {
+
+    var loads = 0
+        private set
+
+    private val stored = MutableStateFlow<List<AbcdefghijklmnopqrstuvwxyzabcdItem>>(emptyList())
+
+    override val items: Flow<List<AbcdefghijklmnopqrstuvwxyzabcdItem>> = stored
+
+    override suspend fun refresh(): AppResult<Unit> {
+        loads++
+        return when (val current = result) {
+            is AppResult.Success -> {
+                stored.value = current.value
+                AppResult.Success(Unit)
+            }
+
+            is AppResult.Failure -> current
+        }
+    }
+
+    override fun peek(id: String): AbcdefghijklmnopqrstuvwxyzabcdItem? =
+        stored.value.firstOrNull { it.id == id }
+
+    override suspend fun item(id: String): AppResult<AbcdefghijklmnopqrstuvwxyzabcdItem> =
+        peek(id)?.let { AppResult.Success(it) } ?: AppResult.Failure(AppError.Http(status = 404))
+
+    /** Rows that reach the list without a refresh: another screen's write, a sync, a push. */
+    fun write(items: List<AbcdefghijklmnopqrstuvwxyzabcdItem>) {
+        stored.value = items
+    }
+}
