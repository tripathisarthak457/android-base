+package io.example.fit.feature.abcdefghij.detail
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.SideEffect
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import io.example.fit.core.navigation.AppNavigator
+import io.example.fit.core.ui.MviScreen
+
+@Composable
+internal fun AbcdefghijDetailRoute(
+    id: String,
+    navigator: AppNavigator,
+    viewModel: AbcdefghijDetailViewModel =
+        hiltViewModel<AbcdefghijDetailViewModel, AbcdefghijDetailViewModel.Factory>(
+            creationCallback = { factory -> factory.create(id) },
+        ),
+) {
+    // Once, when the screen enters composition. Sending an event suspends nothing, so it needs no
+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbcdefghijDetailEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                AbcdefghijDetailEffect.NavigateBack -> navigator.navigateUp()
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijDetailScreen(state = state, onEvent = onEvent)
+    }
+}
