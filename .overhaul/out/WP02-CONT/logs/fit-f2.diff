+@Composable
+internal fun AbDetailScreen(
+    state: AbDetailState,
+    onEvent: (AbDetailEvent) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val title = state.item?.title ?: stringResource(R.string.ab_title)
+    AppScaffold(
+        contentMaxWidth = AppTheme.layout.readableMaxWidth,
+        modifier = modifier,
+        topBar = {
+            AppTopBar(
+                title = title,
+                onBack = { onEvent(AbDetailEvent.BackClicked) },
+            )
+        },
+    ) {
+        val scroll = rememberScrollState()
+        ReportScrollEdge(scroll)
+        val loadState = state.loadState
+        if (loadState is LoadState.Error) {
+            AppStateView(
+                message = loadState.error.text(),
+                kind = if (loadState.error == AppError.Offline) {
+                    StateKind.Offline
+                } else {
+                    StateKind.Error
+                },
+                onAction = { onEvent(AbDetailEvent.Retry) },
+            )
+            return@AppScaffold
+        }
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .verticalScroll(scroll, flingBehavior = AppScrollDefaults.flingBehavior())
+                .padding(chromeContentPadding(PaddingValues(AppTheme.spacing.gutter))),
+        ) {
+            val item = state.item
+            if (item == null) {
+                // A transparent line in the title's style sizes the bone, so the title takes its
+                // place without moving anything.
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth(0.7f)
+                        .clearAndSetSemantics {},
+                ) {
+                    AppText(
+                        text = " ",
+                        style = AppTheme.typography.title2,
+                        color = Color.Transparent,
+                    )
+                    AppSkeleton(modifier = Modifier.matchParentSize(), shape = AppTheme.shapes.xs)
+                }
+            } else {
+                AppText(
+                    text = item.title,
+                    style = AppTheme.typography.title2,
+                    color = AppTheme.colors.contentPrimary,
+                )
+            }
+        }
+    }
+}
