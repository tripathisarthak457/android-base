+                    ),
+                    onEvent = {},
+                )
+            }
+        }
+        compose.waitForIdle()
+        counter.reset()
+
+        compose.onNodeWithTag("primary_list").performScrollToIndex(SCROLLED_TO)
+        compose.waitForIdle()
