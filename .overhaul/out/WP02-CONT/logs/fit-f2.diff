+/**
+ * Straight from the network, with the last answer kept in memory for this process. Without a
+ * database there is nothing to show offline after a restart; the HTTP cache still saves the bytes
+ * of an unchanged list.
+ */
+@Singleton
+internal class NetworkAbcdefghijklmnopqrRepository @Inject constructor(
+    private val api: AbcdefghijklmnopqrApi,
+) : AbcdefghijklmnopqrRepository {
+
+    private val fetched = MutableStateFlow<List<AbcdefghijklmnopqrItem>>(emptyList())
+
+    override val items: Flow<List<AbcdefghijklmnopqrItem>> = fetched.asStateFlow()
+
+    override suspend fun refresh(): AppResult<Unit> =
+        api.items().map { dtos -> fetched.value = dtos.map { it.toDomain() } }
+
+    override fun peek(id: String): AbcdefghijklmnopqrItem? =
+        fetched.value.firstOrNull { it.id == id }
+
+    override suspend fun item(id: String): AppResult<AbcdefghijklmnopqrItem> =
+        peek(id)?.let { AppResult.Success(it) } ?: api.item(id).map { it.toDomain() }
+}
