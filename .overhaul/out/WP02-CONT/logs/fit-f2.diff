+    override fun handleEvent(event: AbcdefghijklmnopDetailEvent) {
+        when (event) {
+            AbcdefghijklmnopDetailEvent.Appeared -> {
+                if (current.loadState == LoadState.Idle) load()
+            }
+
+            AbcdefghijklmnopDetailEvent.Retry -> load()
