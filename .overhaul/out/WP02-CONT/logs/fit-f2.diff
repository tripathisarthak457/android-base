+@Composable
+private fun AbcdefghijklmnopqrstuRowPlaceholder() {
+    AppCard(modifier = Modifier.fillMaxWidth()) {
+        Box(modifier = Modifier.fillMaxWidth(0.6f)) {
+            AppText(text = " ", style = AppTheme.typography.headline, color = Color.Transparent)
