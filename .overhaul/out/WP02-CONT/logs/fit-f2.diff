+    private fun load(refreshing: Boolean) {
+        launchLatest(LOAD) {
+            setState {
+                val showing = refreshing || items.isNotEmpty()
+                copy(loadState = if (showing) LoadState.Refreshing else LoadState.Loading)
+            }
