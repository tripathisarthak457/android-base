+@HiltViewModel
+internal class AbcdListViewModel @Inject constructor(private val repository: AbcdRepository) :
+    MviViewModel<AbcdListState, AbcdListEvent, AbcdListEffect>(
+        initial = AbcdListState(),
+    ) {
+
+    init {
+        // Every write to the list reaches the screen, not only the ones a refresh makes.
+        observe(repository.items) { items ->
+            copy(items = items, loadState = loadState.holding(items.isNotEmpty()))
+        }
