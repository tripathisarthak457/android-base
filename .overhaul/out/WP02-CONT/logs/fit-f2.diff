+    override fun handleEvent(event: AbcdListEvent) {
+        when (event) {
+            AbcdListEvent.Appeared -> {
+                if (current.loadState == LoadState.Idle) load(refreshing = false)
+            }
+
+            AbcdListEvent.Refresh -> load(refreshing = true)
+
+            AbcdListEvent.Retry -> load(refreshing = false)
+
+            is AbcdListEvent.ItemClicked -> {
+                emit(AbcdListEffect.OpenDetail(event.id))
+            }
+        }
+    }
