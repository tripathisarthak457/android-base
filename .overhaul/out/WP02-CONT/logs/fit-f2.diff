+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.SideEffect
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import io.example.fit.core.navigation.AppNavigator
+import io.example.fit.core.ui.MviScreen
+
+@Composable
+internal fun AbcdefghijklmnopqrstuDetailRoute(
+    id: String,
+    navigator: AppNavigator,
+    viewModel: AbcdefghijklmnopqrstuDetailViewModel =
+        hiltViewModel<
+            AbcdefghijklmnopqrstuDetailViewModel,
+            AbcdefghijklmnopqrstuDetailViewModel.Factory,
+            >(
+            creationCallback = { factory -> factory.create(id) },
+        ),
+) {
+    // Once, when the screen enters composition. Sending an event suspends nothing, so it needs no
+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbcdefghijklmnopqrstuDetailEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                AbcdefghijklmnopqrstuDetailEffect.NavigateBack -> navigator.navigateUp()
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijklmnopqrstuDetailScreen(state = state, onEvent = onEvent)
+    }
+}
