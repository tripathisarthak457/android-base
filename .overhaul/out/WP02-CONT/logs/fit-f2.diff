+package io.example.fit.feature.abcdefghijklmnopqrs.navigation
+
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.android.components.ActivityRetainedComponent
+import dagger.multibindings.IntoSet
+import io.example.fit.core.navigation.AppNavigator
+import io.example.fit.core.navigation.NavGraphEntry
+import io.example.fit.core.navigation.NavPane
+import io.example.fit.core.navigation.navGraph
+import io.example.fit.core.navigation.navKeys
+import io.example.fit.feature.abcdefghijklmnopqrs.api.AbcdefghijklmnopqrsDetailKey
+import io.example.fit.feature.abcdefghijklmnopqrs.api.AbcdefghijklmnopqrsListKey
