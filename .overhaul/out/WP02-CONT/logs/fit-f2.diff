+) {
+    val title = state.item?.title ?: stringResource(R.string.abcdef_title)
+    AppScaffold(
+        contentMaxWidth = AppTheme.layout.readableMaxWidth,
+        modifier = modifier,
+        topBar = {
+            AppTopBar(
+                title = title,
+                onBack = { onEvent(AbcdefDetailEvent.BackClicked) },
+            )
+        },
+    ) {
+        val scroll = rememberScrollState()
+        ReportScrollEdge(scroll)
+        val loadState = state.loadState
+        if (loadState is LoadState.Error) {
+            AppStateView(
