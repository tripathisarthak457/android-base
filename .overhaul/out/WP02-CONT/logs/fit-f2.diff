+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbListEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                is AbListEffect.OpenDetail -> {
+                    navigator.navigate(AbDetailKey(effect.id))
+                }
+            }
+        },
+    ) { state, onEvent ->
+        AbListScreen(state = state, onEvent = onEvent)
+    }
