+package io.example.fit.feature.abcdef.detail
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.SideEffect
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import io.example.fit.core.navigation.AppNavigator
+import io.example.fit.core.ui.MviScreen
+
+@Composable
+internal fun AbcdefDetailRoute(
+    id: String,
+    navigator: AppNavigator,
+    viewModel: AbcdefDetailViewModel =
+        hiltViewModel<AbcdefDetailViewModel, AbcdefDetailViewModel.Factory>(
+            creationCallback = { factory -> factory.create(id) },
+        ),
+) {
+    // Once, when the screen enters composition. Sending an event suspends nothing, so it needs no
+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbcdefDetailEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                AbcdefDetailEffect.NavigateBack -> navigator.navigateUp()
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefDetailScreen(state = state, onEvent = onEvent)
+    }
+}
