+            .clearAndSetSemantics { contentDescription = loading },
+        verticalArrangement = Arrangement.spacedBy(AppTheme.spacing.stack),
+    ) {
+        repeat(SKELETON_ROWS) { AbcdefghijklmnopqrstuvwRowPlaceholder() }
+    }
+}
+
+/**
