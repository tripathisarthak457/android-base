+package io.example.fit.feature.abcdefghij.detail
+
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedFactory
+import dagger.assisted.AssistedInject
+import dagger.hilt.android.lifecycle.HiltViewModel
+import io.example.fit.core.common.LoadState
+import io.example.fit.core.common.result.AppResult
+import io.example.fit.core.mvi.MviViewModel
+import io.example.fit.data.abcdefghij.api.AbcdefghijRepository
+
+/** The id arrives through assisted injection, at construction, from the navigation key. */
+@HiltViewModel(assistedFactory = AbcdefghijDetailViewModel.Factory::class)
+internal class AbcdefghijDetailViewModel @AssistedInject constructor(
+    private val repository: AbcdefghijRepository,
+    @Assisted private val id: String,
+) : MviViewModel<AbcdefghijDetailState, AbcdefghijDetailEvent, AbcdefghijDetailEffect>(
+    initial = AbcdefghijDetailState(),
+) {
+
+    @AssistedFactory
+    interface Factory {
+        fun create(id: String): AbcdefghijDetailViewModel
+    }
+
+    override fun handleEvent(event: AbcdefghijDetailEvent) {
+        when (event) {
+            AbcdefghijDetailEvent.Appeared -> {
+                if (current.loadState == LoadState.Idle) load()
+            }
+
+            AbcdefghijDetailEvent.Retry -> load()
+
+            AbcdefghijDetailEvent.BackClicked -> {
+                emit(AbcdefghijDetailEffect.NavigateBack)
+            }
+        }
+    }
+
+    private fun load() {
+        launchLatest(LOAD) {
+            setState { copy(loadState = LoadState.Loading) }
+            when (val result = repository.item(id)) {
+                is AppResult.Success -> setState {
+                    copy(loadState = LoadState.Success, item = result.value)
+                }
+
+                is AppResult.Failure -> setState {
+                    copy(loadState = LoadState.Error(result.error))
+                }
+            }
+        }
+    }
+
+    private companion object {
+        const val LOAD = "load"
+    }
+}
