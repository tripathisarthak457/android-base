+    id: String,
+    navigator: AppNavigator,
+    viewModel: AbcdefghijklmnoDetailViewModel =
+        hiltViewModel<AbcdefghijklmnoDetailViewModel, AbcdefghijklmnoDetailViewModel.Factory>(
