+        viewModel.onEvent(AbcdefghijklmnopqrstuvwxyzabcdListEvent.Appeared)
+        advanceUntilIdle()
+        viewModel.onEvent(AbcdefghijklmnopqrstuvwxyzabcdListEvent.Appeared)
+        advanceUntilIdle()
