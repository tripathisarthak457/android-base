+@Composable
+internal fun AbcdDetailRoute(
+    id: String,
+    navigator: AppNavigator,
+    viewModel: AbcdDetailViewModel =
+        hiltViewModel<AbcdDetailViewModel, AbcdDetailViewModel.Factory>(
+            creationCallback = { factory -> factory.create(id) },
+        ),
+) {
+    // Once, when the screen enters composition. Sending an event suspends nothing, so it needs no
+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbcdDetailEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                AbcdDetailEffect.NavigateBack -> navigator.navigateUp()
+            }
+        },
+    ) { state, onEvent ->
+        AbcdDetailScreen(state = state, onEvent = onEvent)
+    }
+}
