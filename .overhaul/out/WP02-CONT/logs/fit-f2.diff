+        val viewModel = AbcdefghijklmnopqrstuvwxyzabcdListViewModel(repository)
+
+        viewModel.onEvent(AbcdefghijklmnopqrstuvwxyzabcdListEvent.Appeared)
+        advanceUntilIdle()
