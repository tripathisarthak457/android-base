+@HiltViewModel
+internal class AbcdefListViewModel @Inject constructor(private val repository: AbcdefRepository) :
+    MviViewModel<AbcdefListState, AbcdefListEvent, AbcdefListEffect>(
+        initial = AbcdefListState(),
+    ) {
+
+    init {
+        // Every write to the list reaches the screen, not only the ones a refresh makes.
+        observe(repository.items) { items ->
+            copy(items = items, loadState = loadState.holding(items.isNotEmpty()))
+        }
