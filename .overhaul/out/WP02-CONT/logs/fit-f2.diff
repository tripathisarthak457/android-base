+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                is AbcdefghijklmnopqrstListEffect.OpenDetail -> {
+                    navigator.navigate(AbcdefghijklmnopqrstDetailKey(effect.id))
+                }
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijklmnopqrstListScreen(state = state, onEvent = onEvent)
+    }
+}
