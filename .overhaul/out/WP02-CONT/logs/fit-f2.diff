+@Composable
+internal fun AbcdefghijkListScreen(
+    state: AbcdefghijkListState,
+    onEvent: (AbcdefghijkListEvent) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val listState = rememberLazyListState()
+    AppScaffold(
+        contentMaxWidth = AppTheme.layout.readableMaxWidth,
+        modifier = modifier,
+        topBar = {
+            AppLargeTitleTopBar(
+                title = stringResource(R.string.abcdefghijk_title),
+                scrolled = { listState.scrolledFromTop() },
+            )
+        },
+    ) {
+        when (val loadState = state.loadState) {
+            // Idle is the first frame, before the route's Appeared has started the load.
+            LoadState.Idle, LoadState.Loading -> LoadingList()
+
+            is LoadState.Error -> AppStateView(
+                message = loadState.error.text(),
+                kind = if (loadState.error == AppError.Offline) {
+                    StateKind.Offline
+                } else {
+                    StateKind.Error
+                },
+                onAction = { onEvent(AbcdefghijkListEvent.Retry) },
+            )
+
+            LoadState.Empty -> AppStateView(
+                title = stringResource(R.string.abcdefghijk_empty_title),
+                message = stringResource(R.string.abcdefghijk_empty_message),
+                actionLabel = stringResource(R.string.abcdefghijk_reload),
+                onAction = { onEvent(AbcdefghijkListEvent.Retry) },
+            )
+
+            LoadState.Success, LoadState.Refreshing -> AppPullToRefresh(
+                isRefreshing = loadState.isRefreshing,
+                onRefresh = { onEvent(AbcdefghijkListEvent.Refresh) },
+                modifier = Modifier.fillMaxSize(),
+            ) {
+                ScrollToTopOnReselect(listState)
+                ReportScrollEdge(listState)
+                LazyColumn(
+                    modifier = Modifier
+                        .fillMaxSize()
+                        .testTag("primary_list"),
+                    state = listState,
+                    contentPadding = chromeContentPadding(PaddingValues(AppTheme.spacing.gutter)),
+                    verticalArrangement = Arrangement.spacedBy(AppTheme.spacing.stack),
+                    flingBehavior = AppScrollDefaults.flingBehavior(),
+                ) {
+                    items(
+                        items = state.items,
+                        key = AbcdefghijkItem::id,
+                        contentType = { ROW },
+                    ) { item ->
+                        AbcdefghijkRow(
+                            item = item,
+                            onClick = { onEvent(AbcdefghijkListEvent.ItemClicked(item.id)) },
+                        )
+                    }
+                }
+            }
+        }
+    }
