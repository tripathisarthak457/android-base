+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                AbcdefghijklmnoDetailEffect.NavigateBack -> navigator.navigateUp()
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijklmnoDetailScreen(state = state, onEvent = onEvent)
+    }
+}
