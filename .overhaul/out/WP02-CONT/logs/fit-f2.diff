+package io.example.fit.feature.abcd.list
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.SideEffect
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import io.example.fit.core.navigation.AppNavigator
+import io.example.fit.core.ui.MviScreen
+import io.example.fit.feature.abcd.api.AbcdDetailKey
+
+@Composable
+internal fun AbcdListRoute(
+    navigator: AppNavigator,
+    viewModel: AbcdListViewModel = hiltViewModel(),
+) {
+    // Once, when the screen enters composition. Sending an event suspends nothing, so it needs no
+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbcdListEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                is AbcdListEffect.OpenDetail -> {
+                    navigator.navigate(AbcdDetailKey(effect.id))
+                }
+            }
+        },
+    ) { state, onEvent ->
+        AbcdListScreen(state = state, onEvent = onEvent)
+    }
+}
