+class FakeAbcdefghijklmnopqrstuvwxyRepository(
+    var result: AppResult<List<AbcdefghijklmnopqrstuvwxyItem>>,
+) : AbcdefghijklmnopqrstuvwxyRepository {
+
+    var loads = 0
+        private set
+
+    private val stored = MutableStateFlow<List<AbcdefghijklmnopqrstuvwxyItem>>(emptyList())
+
+    override val items: Flow<List<AbcdefghijklmnopqrstuvwxyItem>> = stored
+
+    override suspend fun refresh(): AppResult<Unit> {
+        loads++
+        return when (val current = result) {
+            is AppResult.Success -> {
+                stored.value = current.value
+                AppResult.Success(Unit)
+            }
+
+            is AppResult.Failure -> current
+        }
+    }
+
+    override fun peek(id: String): AbcdefghijklmnopqrstuvwxyItem? =
+        stored.value.firstOrNull { it.id == id }
+
+    override suspend fun item(id: String): AppResult<AbcdefghijklmnopqrstuvwxyItem> =
+        peek(id)?.let { AppResult.Success(it) } ?: AppResult.Failure(AppError.Http(status = 404))
+
+    /** Rows that reach the list without a refresh: another screen's write, a sync, a push. */
+    fun write(items: List<AbcdefghijklmnopqrstuvwxyItem>) {
+        stored.value = items
+    }
+}
