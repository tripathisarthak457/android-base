+package io.example.fit.feature.abcdefghijklmnopqrstuvwxyz.detail
+
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedFactory
+import dagger.assisted.AssistedInject
+import dagger.hilt.android.lifecycle.HiltViewModel
+import io.example.fit.core.common.LoadState
+import io.example.fit.core.common.result.AppResult
+import io.example.fit.core.mvi.MviViewModel
+import io.example.fit.data.abcdefghijklmnopqrstuvwxyz.api.AbcdefghijklmnopqrstuvwxyzRepository
+
+/** The id arrives through assisted injection, at construction, from the navigation key. */
+@HiltViewModel(assistedFactory = AbcdefghijklmnopqrstuvwxyzDetailViewModel.Factory::class)
+internal class AbcdefghijklmnopqrstuvwxyzDetailViewModel @AssistedInject constructor(
+    private val repository: AbcdefghijklmnopqrstuvwxyzRepository,
+    @Assisted private val id: String,
+) : MviViewModel<
+    AbcdefghijklmnopqrstuvwxyzDetailState,
+    AbcdefghijklmnopqrstuvwxyzDetailEvent,
+    AbcdefghijklmnopqrstuvwxyzDetailEffect,
+    >(
+    initial = AbcdefghijklmnopqrstuvwxyzDetailState(),
+) {
+
+    @AssistedFactory
+    interface Factory {
+        fun create(id: String): AbcdefghijklmnopqrstuvwxyzDetailViewModel
+    }
+
+    override fun handleEvent(event: AbcdefghijklmnopqrstuvwxyzDetailEvent) {
+        when (event) {
+            AbcdefghijklmnopqrstuvwxyzDetailEvent.Appeared -> {
+                if (current.loadState == LoadState.Idle) load()
+            }
+
+            AbcdefghijklmnopqrstuvwxyzDetailEvent.Retry -> load()
+
+            AbcdefghijklmnopqrstuvwxyzDetailEvent.BackClicked -> {
+                emit(AbcdefghijklmnopqrstuvwxyzDetailEffect.NavigateBack)
+            }
+        }
+    }
+
+    private fun load() {
+        launchLatest(LOAD) {
+            setState { copy(loadState = LoadState.Loading) }
+            when (val result = repository.item(id)) {
+                is AppResult.Success -> setState {
+                    copy(loadState = LoadState.Success, item = result.value)
+                }
+
+                is AppResult.Failure -> setState {
+                    copy(loadState = LoadState.Error(result.error))
+                }
+            }
+        }
+    }
+
+    private companion object {
+        const val LOAD = "load"
+    }
+}
