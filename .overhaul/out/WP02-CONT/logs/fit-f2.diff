+package io.example.fit.feature.abcdefghijklmnopqrstuv.detail
+
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedFactory
+import dagger.assisted.AssistedInject
+import dagger.hilt.android.lifecycle.HiltViewModel
+import io.example.fit.core.common.LoadState
+import io.example.fit.core.common.result.AppResult
+import io.example.fit.core.mvi.MviViewModel
+import io.example.fit.data.abcdefghijklmnopqrstuv.api.AbcdefghijklmnopqrstuvRepository
+
+/** The id arrives through assisted injection, at construction, from the navigation key. */
+@HiltViewModel(assistedFactory = AbcdefghijklmnopqrstuvDetailViewModel.Factory::class)
+internal class AbcdefghijklmnopqrstuvDetailViewModel @AssistedInject constructor(
+    private val repository: AbcdefghijklmnopqrstuvRepository,
+    @Assisted private val id: String,
+) : MviViewModel<
+    AbcdefghijklmnopqrstuvDetailState,
+    AbcdefghijklmnopqrstuvDetailEvent,
+    AbcdefghijklmnopqrstuvDetailEffect,
+    >(
+    initial = AbcdefghijklmnopqrstuvDetailState(),
+) {
+
+    @AssistedFactory
+    interface Factory {
+        fun create(id: String): AbcdefghijklmnopqrstuvDetailViewModel
+    }
+
+    override fun handleEvent(event: AbcdefghijklmnopqrstuvDetailEvent) {
+        when (event) {
+            AbcdefghijklmnopqrstuvDetailEvent.Appeared -> {
+                if (current.loadState == LoadState.Idle) load()
+            }
+
+            AbcdefghijklmnopqrstuvDetailEvent.Retry -> load()
+
+            AbcdefghijklmnopqrstuvDetailEvent.BackClicked -> {
+                emit(AbcdefghijklmnopqrstuvDetailEffect.NavigateBack)
+            }
+        }
+    }
+
+    private fun load() {
+        launchLatest(LOAD) {
+            setState { copy(loadState = LoadState.Loading) }
+            when (val result = repository.item(id)) {
+                is AppResult.Success -> setState {
+                    copy(loadState = LoadState.Success, item = result.value)
+                }
+
+                is AppResult.Failure -> setState {
+                    copy(loadState = LoadState.Error(result.error))
+                }
+            }
+        }
+    }
+
+    private companion object {
+        const val LOAD = "load"
