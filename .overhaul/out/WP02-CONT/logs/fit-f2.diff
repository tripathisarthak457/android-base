+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                is AbcdefghijklmnopqrstuvListEffect.OpenDetail -> {
+                    navigator.navigate(AbcdefghijklmnopqrstuvDetailKey(effect.id))
+                }
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijklmnopqrstuvListScreen(state = state, onEvent = onEvent)
+    }
+}
