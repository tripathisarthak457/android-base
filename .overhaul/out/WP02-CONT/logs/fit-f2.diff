+@HiltViewModel(assistedFactory = AbcdefghijklmnopqDetailViewModel.Factory::class)
+internal class AbcdefghijklmnopqDetailViewModel @AssistedInject constructor(
+    private val repository: AbcdefghijklmnopqRepository,
+    @Assisted private val id: String,
+) : MviViewModel<
+    AbcdefghijklmnopqDetailState,
+    AbcdefghijklmnopqDetailEvent,
+    AbcdefghijklmnopqDetailEffect,
+    >(
+    initial = AbcdefghijklmnopqDetailState(),
+) {
+
+    @AssistedFactory
+    interface Factory {
+        fun create(id: String): AbcdefghijklmnopqDetailViewModel
+    }
+
+    override fun handleEvent(event: AbcdefghijklmnopqDetailEvent) {
+        when (event) {
+            AbcdefghijklmnopqDetailEvent.Appeared -> {
+                if (current.loadState == LoadState.Idle) load()
+            }
+
+            AbcdefghijklmnopqDetailEvent.Retry -> load()
+
+            AbcdefghijklmnopqDetailEvent.BackClicked -> {
+                emit(AbcdefghijklmnopqDetailEffect.NavigateBack)
+            }
+        }
+    }
+
+    private fun load() {
+        launchLatest(LOAD) {
+            setState { copy(loadState = LoadState.Loading) }
+            when (val result = repository.item(id)) {
+                is AppResult.Success -> setState {
+                    copy(loadState = LoadState.Success, item = result.value)
+                }
+
+                is AppResult.Failure -> setState {
+                    copy(loadState = LoadState.Error(result.error))
+                }
+            }
+        }
+    }
+
+    private companion object {
+        const val LOAD = "load"
+    }
+}
