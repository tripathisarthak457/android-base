+package io.example.fit.feature.abcdefghijklmnopqrstuvwxyza.list
+
+import dagger.hilt.android.lifecycle.HiltViewModel
+import io.example.fit.core.common.LoadState
+import io.example.fit.core.common.result.AppResult
+import io.example.fit.core.mvi.MessageKind
+import io.example.fit.core.mvi.MviViewModel
+import io.example.fit.core.ui.toUiText
+import io.example.fit.data.abcdefghijklmnopqrstuvwxyza.api.AbcdefghijklmnopqrstuvwxyzaRepository
+import javax.inject.Inject
+import kotlinx.coroutines.flow.first
