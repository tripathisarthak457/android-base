+
+    var loads = 0
+        private set
+
+    private val stored = MutableStateFlow<List<AbcdefghijklmnopqrstuvwxItem>>(emptyList())
+
+    override val items: Flow<List<AbcdefghijklmnopqrstuvwxItem>> = stored
+
+    override suspend fun refresh(): AppResult<Unit> {
+        loads++
+        return when (val current = result) {
+            is AppResult.Success -> {
+                stored.value = current.value
