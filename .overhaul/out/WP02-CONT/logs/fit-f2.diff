+    >(
+    initial = AbcdefghijklmnopqrstuvwxyzaListState(),
+) {
+
+    init {
+        // Every write to the list reaches the screen, not only the ones a refresh makes.
+        observe(repository.items) { items ->
+            copy(items = items, loadState = loadState.holding(items.isNotEmpty()))
+        }
+    }
+
+    override fun handleEvent(event: AbcdefghijklmnopqrstuvwxyzaListEvent) {
+        when (event) {
+            AbcdefghijklmnopqrstuvwxyzaListEvent.Appeared -> {
+                if (current.loadState == LoadState.Idle) load(refreshing = false)
+            }
+
+            AbcdefghijklmnopqrstuvwxyzaListEvent.Refresh -> load(refreshing = true)
+
+            AbcdefghijklmnopqrstuvwxyzaListEvent.Retry -> load(refreshing = false)
+
+            is AbcdefghijklmnopqrstuvwxyzaListEvent.ItemClicked -> {
+                emit(AbcdefghijklmnopqrstuvwxyzaListEffect.OpenDetail(event.id))
+            }
+        }
+    }
