+@Composable
+internal fun AbcDetailScreen(
+    state: AbcDetailState,
+    onEvent: (AbcDetailEvent) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val title = state.item?.title ?: stringResource(R.string.abc_title)
+    AppScaffold(
+        contentMaxWidth = AppTheme.layout.readableMaxWidth,
+        modifier = modifier,
+        topBar = {
+            AppTopBar(
+                title = title,
+                onBack = { onEvent(AbcDetailEvent.BackClicked) },
+            )
+        },
+    ) {
+        val scroll = rememberScrollState()
+        ReportScrollEdge(scroll)
+        val loadState = state.loadState
+        if (loadState is LoadState.Error) {
+            AppStateView(
+                message = loadState.error.text(),
+                kind = if (loadState.error == AppError.Offline) {
+                    StateKind.Offline
+                } else {
+                    StateKind.Error
+                },
+                onAction = { onEvent(AbcDetailEvent.Retry) },
+            )
+            return@AppScaffold
+        }
+
