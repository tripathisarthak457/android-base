+@Singleton
+internal class OfflineFirstAbcdefghijklmnopqrstuvwxyRepository @Inject constructor(
+    private val api: AbcdefghijklmnopqrstuvwxyApi,
+    private val dao: AbcdefghijklmnopqrstuvwxyDao,
