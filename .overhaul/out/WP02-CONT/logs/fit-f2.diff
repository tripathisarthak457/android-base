+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                AbcdefghijklmnopqDetailEffect.NavigateBack -> navigator.navigateUp()
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijklmnopqDetailScreen(state = state, onEvent = onEvent)
+    }
