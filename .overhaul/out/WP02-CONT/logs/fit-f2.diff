+                AbcdefghijklmnopqrstuvwxyzaListScreen(
+                    state = AbcdefghijklmnopqrstuvwxyzaListState(
+                        loadState = LoadState.Success,
+                        items = items,
+                    ),
+                    onEvent = {},
+                )
+            }
+        }
+        compose.waitForIdle()
+        counter.reset()
+
+        compose.onNodeWithTag("primary_list").performScrollToIndex(SCROLLED_TO)
+        compose.waitForIdle()
+
