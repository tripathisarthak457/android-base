+
+    var loads = 0
+        private set
+
+    private val stored = MutableStateFlow<List<AbcdefghijklmnopqrstuvwxyzabcItem>>(emptyList())
+
+    override val items: Flow<List<AbcdefghijklmnopqrstuvwxyzabcItem>> = stored
+
+    override suspend fun refresh(): AppResult<Unit> {
+        loads++
+        return when (val current = result) {
+            is AppResult.Success -> {
+                stored.value = current.value
+                AppResult.Success(Unit)
+            }
+
+            is AppResult.Failure -> current
+        }
+    }
+
+    override fun peek(id: String): AbcdefghijklmnopqrstuvwxyzabcItem? =
