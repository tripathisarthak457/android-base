+            when (effect) {
+                is AbcdefghijklmnopqrsListEffect.OpenDetail -> {
+                    navigator.navigate(AbcdefghijklmnopqrsDetailKey(effect.id))
+                }
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijklmnopqrsListScreen(state = state, onEvent = onEvent)
+    }
+}
