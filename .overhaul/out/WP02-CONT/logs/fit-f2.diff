+package io.example.fit.feature.abcdefghijklmnopqrstuv.detail
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.SideEffect
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import io.example.fit.core.navigation.AppNavigator
+import io.example.fit.core.ui.MviScreen
+
+@Composable
+internal fun AbcdefghijklmnopqrstuvDetailRoute(
+    id: String,
+    navigator: AppNavigator,
+    viewModel: AbcdefghijklmnopqrstuvDetailViewModel =
+        hiltViewModel<
+            AbcdefghijklmnopqrstuvDetailViewModel,
+            AbcdefghijklmnopqrstuvDetailViewModel.Factory,
+            >(
+            creationCallback = { factory -> factory.create(id) },
+        ),
+) {
+    // Once, when the screen enters composition. Sending an event suspends nothing, so it needs no
+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbcdefghijklmnopqrstuvDetailEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                AbcdefghijklmnopqrstuvDetailEffect.NavigateBack -> navigator.navigateUp()
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghijklmnopqrstuvDetailScreen(state = state, onEvent = onEvent)
+    }
+}
