+@Singleton
+internal class OfflineFirstAbcdefghijklmnopqrstuvwxyzaRepository @Inject constructor(
+    private val api: AbcdefghijklmnopqrstuvwxyzaApi,
+    private val dao: AbcdefghijklmnopqrstuvwxyzaDao,
+) : AbcdefghijklmnopqrstuvwxyzaRepository {
+
+    private val readLock = Any()
+    private var readers = 0
+
+    // What the readers of [items] saw last, for [peek]. It goes with the last reader, so rows the
+    // database has dropped since (a sign-out empties it) are never answered from memory.
+    private var lastRead: List<AbcdefghijklmnopqrstuvwxyzaItem>? = null
