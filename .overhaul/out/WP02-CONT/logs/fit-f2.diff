+package io.example.fit.feature.abcdefgh.list
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.SideEffect
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import io.example.fit.core.navigation.AppNavigator
+import io.example.fit.core.ui.MviScreen
+import io.example.fit.feature.abcdefgh.api.AbcdefghDetailKey
+
+@Composable
+internal fun AbcdefghListRoute(
+    navigator: AppNavigator,
+    viewModel: AbcdefghListViewModel = hiltViewModel(),
+) {
+    // Once, when the screen enters composition. Sending an event suspends nothing, so it needs no
+    // coroutine of its own.
+    SideEffect(Unit) { viewModel.onEvent(AbcdefghListEvent.Appeared) }
+
+    MviScreen(
+        viewModel = viewModel,
+        onEffect = { effect ->
+            when (effect) {
+                is AbcdefghListEffect.OpenDetail -> {
+                    navigator.navigate(AbcdefghDetailKey(effect.id))
+                }
+            }
+        },
+    ) { state, onEvent ->
+        AbcdefghListScreen(state = state, onEvent = onEvent)
+    }
+}
