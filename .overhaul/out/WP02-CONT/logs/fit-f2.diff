+                        items = state.items,
+                        key = AbcdefghItem::id,
+                        contentType = { ROW },
+                    ) { item ->
+                        AbcdefghRow(
+                            item = item,
+                            onClick = { onEvent(AbcdefghListEvent.ItemClicked(item.id)) },
+                        )
+                    }
+                }
+            }
+        }
+    }
