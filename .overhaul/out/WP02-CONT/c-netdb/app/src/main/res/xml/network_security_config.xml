<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds talk to HTTPS hosts only, and trust only the system's certificate authorities.
  Debug builds use src/debug/res/xml/network_security_config.xml instead.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
