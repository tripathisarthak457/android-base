<?xml version="1.0" encoding="utf-8"?>
<!--
  Declared by the module that loads remote images, so a project with images and without the
  networking module can still reach the network. Coil declares no permission of its own.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
