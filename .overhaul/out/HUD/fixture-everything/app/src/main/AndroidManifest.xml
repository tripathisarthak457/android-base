<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions, services and providers are declared by the module whose code needs them, and
         manifest merging brings them here: INTERNET from :core:network, POST_NOTIFICATIONS from
         :core:notification. -->
    <application
        android:name=".EverythingApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Everything">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Everything.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Custom scheme. Always works, never verified, and any app can claim the same scheme —
              so it is the fallback, not the primary route in.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/deeplink_scheme" />
            </intent-filter>

            <!--
              App Links. `autoVerify` makes Android check /.well-known/assetlinks.json on the host
              at install time; when it matches, these URLs open the app directly with no chooser.
              Without a correctly served assetlinks.json the filter still works, but the user gets
              a disambiguation dialog every time — which most of them will answer with "browser".
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="@string/deeplink_host"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          WorkManager starts the first time the offline queue asks for it, through
          EverythingApplication's Configuration.Provider, instead of at every launch from App Startup:
          most launches queue nothing, and its start-up opens a database. The removal sits with the
          Application that takes over from it.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
