#!/usr/bin/env bash
# Logs every thermal sensor, charging state and free memory every 5 s, synced to disk, so a sudden power-off
# leaves its last readings behind (Oct 16: two power-offs with no kernel log; SEN3 reads 60-125 C).
out=/home/crazyhusir/Documents/projects/tools/.overhaul/logs/thermal.log
while true; do
  line="$(date +%T)"
  for z in /sys/class/thermal/thermal_zone*; do line+=" $(tr ' ' _ <"$z/type")=$(( $(cat "$z/temp") / 1000 ))"; done
  line+=" bat=$(cat /sys/class/power_supply/BAT0/status)/$(cat /sys/class/power_supply/BAT0/capacity)%"
  line+=" memavail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)MB load=$(cut -d' ' -f1 /proc/loadavg)"
  echo "$line" >>"$out"; sync "$out"
  sleep 5
done
