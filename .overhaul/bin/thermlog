#!/usr/bin/env bash
# Git Bash shim: the logic is in locked.py (native Windows). MSYS_NO_PATHCONV keeps Git Bash from rewriting arguments
# such as /sdcard/... on the way into Python; locked.py gives the command the caller's own setting back.
export LOCKED_CALLER_NOPATHCONV="${MSYS_NO_PATHCONV-unset}"
export LOCKED_BASH="$(cygpath -w "$BASH")"
export MSYS_NO_PATHCONV=1
exec python -I "$(cygpath -m "$(dirname "$0")")/locked.py" thermlog "$@"
